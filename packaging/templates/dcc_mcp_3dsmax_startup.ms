-- Auto-generated by dcc-mcp-3dsmax MZP installer.
-- Adds the installed Python packages to sys.path and installs the DCC MCP menu.
(
    fn _dccMcpNormalizePath value =
    (
        substituteString value "\\" "/"
    )

    local userScripts = _dccMcpNormalizePath (getDir #userScripts)
    local installRoot = _dccMcpNormalizePath (userScripts + "/dcc_mcp_3dsmax")
    local uninstallMarker = _dccMcpNormalizePath (userScripts + "/dcc_mcp_3dsmax_uninstall_pending")
    local legacyUninstallMarker = _dccMcpNormalizePath (userScripts + "/dcc_mcp_3dsmax/dcc_mcp_3dsmax_uninstall_pending")
    local startupScript = _dccMcpNormalizePath (getDir #userStartupScripts + "/dcc_mcp_3dsmax_startup.ms")
    local py = ""
    py += "from pathlib import Path\n"
    py += "from email.parser import Parser\n"
    py += "import os, re, shutil, sys, stat\n"
    py += "try:\n"
    py += "    from dcc_mcp_core.install_lifecycle import safe_remove_tree\n"
    py += "except Exception:\n"
    py += "    safe_remove_tree = None\n"
    py += "root = Path(r'''" + installRoot + "''')\n"
    py += "uninstall_marker = Path(r'''" + uninstallMarker + "''')\n"
    py += "legacy_uninstall_marker = Path(r'''" + legacyUninstallMarker + "''')\n"
    py += "uninstall_markers = [uninstall_marker, legacy_uninstall_marker]\n"
    py += "startup_script = Path(r'''" + startupScript + "''')\n"
    py += "_SAFE_NAME = re.compile(r'[A-Za-z0-9][A-Za-z0-9._-]{0,127}\\Z')\n"
    py += "_RESERVED_NAMES = {'CON', 'PRN', 'AUX', 'NUL'} | {'COM' + str(i) for i in range(1, 10)} | {'LPT' + str(i) for i in range(1, 10)}\n"
    py += "_REPARSE_POINT = 0x400\n"
    py += "def _is_link_or_reparse(path):\n"
    py += "    try:\n"
    py += "        info = os.lstat(str(path))\n"
    py += "    except OSError:\n"
    py += "        return False\n"
    py += "    return path.is_symlink() or bool(getattr(info, 'st_file_attributes', 0) & _REPARSE_POINT)\n"
    py += "def _identity(path):\n"
    py += "    info = os.lstat(str(path))\n"
    py += "    return (getattr(info, 'st_dev', 0), getattr(info, 'st_ino', 0), getattr(info, 'st_mode', 0), getattr(info, 'st_file_attributes', 0))\n"
    py += "def _controlled(path, parent, label, identity=None, allow_missing=False):\n"
    py += "    parent_resolved = Path(os.path.realpath(str(parent)))\n"
    py += "    if _is_link_or_reparse(parent):\n"
    py += "        raise RuntimeError('refusing linked/reparse ' + label + ' root')\n"
    py += "    if not os.path.lexists(str(path)):\n"
    py += "        if allow_missing: return None\n"
    py += "        raise RuntimeError(label + ' is missing')\n"
    py += "    if _is_link_or_reparse(path):\n"
    py += "        raise RuntimeError('refusing linked/reparse ' + label)\n"
    py += "    resolved = Path(os.path.realpath(str(path)))\n"
    py += "    if resolved != parent_resolved and parent_resolved not in resolved.parents:\n"
    py += "        raise RuntimeError(label + ' escapes controlled root')\n"
    py += "    actual = _identity(path)\n"
    py += "    if label == 'current.txt' and (not os.path.isfile(str(path)) or getattr(os.lstat(str(path)), 'st_nlink', 1) != 1):\n"
    py += "        raise RuntimeError('current.txt must be an independent regular file')\n"
    py += "    if identity is not None and actual != identity:\n"
    py += "        raise RuntimeError(label + ' identity changed')\n"
    py += "    return actual\n"
    py += "def _split_paths(raw):\n"
    py += "    if not raw:\n"
    py += "        return []\n"
    py += "    return [Path(part.strip()).expanduser() for part in raw.split(os.pathsep) if part.strip()]\n"
    py += "def _is_python37_root(path):\n"
    py += "    return path.name.lower() == 'python37'\n"
    py += "def _candidate_python_dirs(base):\n"
    py += "    if sys.version_info >= (3, 8) and _is_python37_root(base):\n"
    py += "        return [base.parent / 'python', base.parent / 'src', base.parent]\n"
    py += "    candidates = [base / ('python37' if sys.version_info < (3, 8) else 'python'), base / 'python', base / 'src', base]\n"
    py += "    if sys.version_info >= (3, 8):\n"
    py += "        candidates = [path for path in candidates if not _is_python37_root(path)]\n"
    py += "    return candidates\n"
    py += "def _compatible_python_path(path):\n"
    py += "    return not (sys.version_info >= (3, 8) and _is_python37_root(path))\n"
    py += "def _existing(paths):\n"
    py += "    return [path for path in paths if path.exists() and _compatible_python_path(path)]\n"
    py += "def _prepend(paths):\n"
    py += "    for path in reversed(_existing(paths)):\n"
    py += "        text = str(path)\n"
    py += "        if text not in sys.path:\n"
    py += "            sys.path.insert(0, text)\n"
    py += "def _validated_pkg(base, base_id=None):\n"
    py += "    if base == root:\n"
    py += "        _controlled(base, root.parent, 'install')\n"
    py += "    else:\n"
    py += "        _controlled(base, root / 'versions', 'active version', base_id)\n"
    py += "    pkg = base / ('python37' if sys.version_info < (3, 8) else 'python')\n"
    py += "    pkg_id = _controlled(pkg, base, 'runtime package')\n"
    py += "    _controlled(pkg, base, 'runtime package', pkg_id)\n"
    py += "    return pkg, pkg_id\n"
    py += "def _import_bound(pkg, pkg_id, base):\n"
    py += "    with os.scandir(str(pkg)) as _pkg_handle:\n"
    py += "        _controlled(pkg, base, 'runtime package', pkg_id)\n"
    py += "        module = __import__('dcc_mcp_3dsmax')\n"
    py += "        _controlled(pkg, base, 'runtime package', pkg_id)\n"
    py += "        return module\n"
    py += "def _env_python_paths():\n"
    py += "    paths = []\n"
    py += "    paths.extend(_split_paths(os.environ.get('DCC_MCP_3DSMAX_BOOTSTRAP_PATHS')))\n"
    py += "    paths.extend(_split_paths(os.environ.get('DCC_MCP_PYTHONPATHS')))\n"
    py += "    for name in ('DCC_MCP_3DSMAX_ROOT', 'DCC_MCP_CORE_ROOT', 'DCC_MCP_SERVER_ROOT'):\n"
    py += "        value = os.environ.get(name)\n"
    py += "        if value:\n"
    py += "            paths.extend(_candidate_python_dirs(Path(value).expanduser()))\n"
    py += "    return paths\n"
    py += "def _installed_root():\n"
    py += "    _controlled(root, root.parent, 'install', allow_missing=True)\n"
    py += "    current_file = root / 'current.txt'\n"
    py += "    versions_dir = root / 'versions'\n"
    py += "    if os.path.lexists(str(versions_dir)): _controlled(versions_dir, root, 'versions')\n"
    py += "    if os.path.lexists(str(current_file)):\n"
    py += "        current_id = _controlled(current_file, root, 'current.txt')\n"
    py += "        current = current_file.read_text(encoding='utf-8').strip()\n"
    py += "        _controlled(current_file, root, 'current.txt', current_id)\n"
    py += "        if (not _SAFE_NAME.fullmatch(current or '') or current.rstrip(' .') != current or current.split('.')[0].upper() in _RESERVED_NAMES):\n"
    py += "            raise RuntimeError('invalid active version name')\n"
    py += "        candidate = versions_dir / current\n"
    py += "        if os.path.lexists(str(candidate)):\n"
    py += "            candidate_id = _controlled(candidate, versions_dir, 'active version')\n"
    py += "            _controlled(candidate, versions_dir, 'active version', candidate_id)\n"
    py += "            return candidate, candidate_id\n"
    py += "    return root, None\n"
    py += "def _uninstall_pending():\n"
    py += "    return any(os.path.lexists(str(marker)) for marker in uninstall_markers)\n"
    py += "def _clear_uninstall_markers():\n"
    py += "    for marker in uninstall_markers:\n"
    py += "        try:\n"
    py += "            if os.path.lexists(str(marker)):\n"
    py += "                marker_id = _controlled(marker, marker.parent, 'uninstall marker')\n"
    py += "                _controlled(marker, marker.parent, 'uninstall marker', marker_id)\n"
    py += "                marker.unlink()\n"
    py += "                if os.path.lexists(str(marker)): raise RuntimeError('uninstall marker reappeared')\n"
    py += "        except OSError:\n"
    py += "            pass\n"
    py += "def _remove_bound_tree(path, identity, parent, parent_identity, boundary):\n"
    py += "    _controlled(parent, boundary, 'cleanup parent', parent_identity)\n"
    py += "    _controlled(path, parent, 'cleanup target', identity)\n"
    py += "    for entry in list(os.scandir(str(path))):\n"
    py += "        _controlled(path, parent, 'cleanup target', identity)\n"
    py += "        child = Path(entry.path)\n"
    py += "        child_id = _controlled(child, path, 'cleanup child')\n"
    py += "        child_info = os.lstat(str(child))\n"
    py += "        if stat.S_ISDIR(child_info.st_mode):\n"
    py += "            _remove_bound_tree(child, child_id, path, identity, root)\n"
    py += "        else:\n"
    py += "            _controlled(child, path, 'cleanup child', child_id)\n"
    py += "            child.unlink()\n"
    py += "            if os.path.lexists(str(child)): raise RuntimeError('cleanup child reappeared')\n"
    py += "        _controlled(path, parent, 'cleanup target', identity)\n"
    py += "    _controlled(path, parent, 'cleanup target', identity)\n"
    py += "    path.rmdir()\n"
    py += "    if os.path.lexists(str(path)): raise RuntimeError('cleanup target reappeared')\n"
    py += "def _safe_remove_tree(path):\n"
    py += "    parent = path.parent\n"
    py += "    boundary = root.parent if path == root else root\n"
    py += "    if not os.path.lexists(str(path)):\n"
    py += "        return {'success': True, 'status': 'skipped'}\n"
    py += "    before_parent = _controlled(parent, boundary, 'cleanup parent')\n"
    py += "    before = _controlled(path, parent, 'cleanup target')\n"
    py += "    if path.is_file():\n"
    py += "        _controlled(path, parent, 'cleanup target', before)\n"
    py += "        path.unlink()\n"
    py += "        _controlled(parent, boundary, 'cleanup parent', before_parent)\n"
    py += "        if os.path.lexists(str(path)): raise RuntimeError('cleanup target reappeared')\n"
    py += "        return {'success': True, 'status': 'removed'}\n"
    py += "    try:\n"
    py += "        install_payload, install_payload_id = _installed_root()\n"
    py += "        pkg, pkg_id = _validated_pkg(install_payload, install_payload_id)\n"
    py += "    except (OSError, RuntimeError):\n"
    py += "        install_payload, pkg, pkg_id = root, None, None\n"
    py += "    if pkg is not None and pkg.exists() and str(pkg) not in sys.path:\n"
    py += "        sys.path.insert(0, str(pkg))\n"
    py += "    if pkg is None:\n"
    py += "        _controlled(path, parent, 'cleanup target', before)\n"
    py += "        raise RuntimeError('runtime cleanup helper unavailable; refusing recursive delete')\n"
    py += "        _controlled(parent, boundary, 'cleanup parent', before_parent)\n"
    py += "        if os.path.lexists(str(path)): raise RuntimeError('cleanup target reappeared')\n"
    py += "        return {'success': True, 'status': 'removed'}\n"
    py += "    _controlled(path, parent, 'cleanup target', before)\n"
    py += "    try:\n"
    py += "        _remove_bound_tree(path, before, parent, before_parent, boundary)\n"
    py += "    except PermissionError as exc:\n"
    py += "        _controlled(parent, boundary, 'cleanup parent', before_parent)\n"
    py += "        return {'success': False, 'requires_restart': True, 'message': str(exc)}\n"
    py += "    _controlled(parent, boundary, 'cleanup parent', before_parent)\n"
    py += "    return {'success': True, 'status': 'removed'}\n"
    py += "def _cleanup_obsolete_payloads(active_root):\n"
    py += "    if active_root == root or not os.path.lexists(str(root)):\n"
    py += "        return\n"
    py += "    _controlled(active_root, root / 'versions', 'active version')\n"
    py += "    active_name = active_root.name\n"
    py += "    obsolete = []\n"
    py += "    versions_dir = root / 'versions'\n"
    py += "    _controlled(versions_dir, root, 'versions')\n"
    py += "    if os.path.lexists(str(versions_dir)):\n"
    py += "        obsolete.extend(path for path in versions_dir.iterdir() if path.name != active_name and not path.name.endswith('.installing'))\n"
    py += "    for path in root.iterdir():\n"
    py += "        if path.name in ('versions', 'current.txt'):\n"
    py += "            continue\n"
    py += "        if path in uninstall_markers:\n"
    py += "            continue\n"
    py += "        obsolete.append(path)\n"
    py += "    restart_paths = []\n"
    py += "    for path in obsolete:\n"
    py += "        try:\n"
    py += "            result = _safe_remove_tree(path)\n"
    py += "            if result.get('requires_restart'):\n"
    py += "                restart_paths.append((path, result.get('message')))\n"
    py += "        except Exception as exc:\n"
    py += "            print('Failed to cleanup old dcc-mcp-3dsmax payload:', path, exc)\n"
    py += "    if restart_paths:\n"
    py += "        print('Old dcc-mcp-3dsmax payload cleanup requires restart:')\n"
    py += "        for path, msg in restart_paths:\n"
    py += "            print('  -', path, msg)\n"
    py += "if _uninstall_pending():\n"
    py += "    cleanup_done = True\n"
    py += "    if os.path.lexists(str(root)):\n"
    py += "        result = _safe_remove_tree(root)\n"
    py += "        if result.get('requires_restart'):\n"
    py += "            cleanup_done = False\n"
    py += "            print('Deferred dcc-mcp-3dsmax uninstall still requires restart:', result.get('message'))\n"
    py += "    if cleanup_done and os.path.lexists(str(startup_script)):\n"
    py += "        startup_id = _controlled(startup_script, startup_script.parent, 'startup script')\n"
    py += "        _controlled(startup_script, startup_script.parent, 'startup script', startup_id)\n"
    py += "        startup_script.unlink()\n"
    py += "        if os.path.lexists(str(startup_script)): raise RuntimeError('startup script reappeared')\n"
    py += "    if cleanup_done:\n"
    py += "        try:\n"
    py += "            import dcc_mcp_3dsmax\n"
    py += "            dcc_mcp_3dsmax.remove_menu()\n"
    py += "        except Exception:\n"
    py += "            try:\n"
    py += "                import pymxs\n"
    py += "                pymxs.runtime.execute(r'''\n"
    py += "local userMacrosDir = getDir #userMacros\n"
    py += "try (if menuMan.findMenu \"DCC MCP\" != undefined do (local mb = menuMan.getMainMenuBar(); for i = mb.numItems() to 1 by -1 do (local it = mb.getItem i; if classOf it == SubMenuItem and it.getTitle() == \"DCC MCP\" do mb.removeItem i); menuMan.unRegisterMenuContext 0x3D5A9765; menuMan.updateMenuBar())) catch()\n"
    py += "try (macros.delete \"DccMcp3dsmax_StartSidecar\") catch()\n"
    py += "try (macros.delete \"DccMcp3dsmax_StopSidecar\") catch()\n"
    py += "try (macros.delete \"DccMcp3dsmax_OpenAdmin\") catch()\n"
    py += "try (macros.delete \"DccMcp3dsmax_PrintStatus\") catch()\n"
    py += "try (deleteFile (userMacrosDir + \"\\\\DCC MCP-DccMcp3dsmax_StartSidecar.mcr\")) catch()\n"
    py += "try (deleteFile (userMacrosDir + \"\\\\DCC MCP-DccMcp3dsmax_StopSidecar.mcr\")) catch()\n"
    py += "try (deleteFile (userMacrosDir + \"\\\\DCC MCP-DccMcp3dsmax_OpenAdmin.mcr\")) catch()\n"
    py += "try (deleteFile (userMacrosDir + \"\\\\DCC MCP-DccMcp3dsmax_PrintStatus.mcr\")) catch()\n"
    py += "try (callbacks.removeScripts id:#dcc_mcp_3dsmax_shutdown) catch()\n"
    py += "print \"dcc-mcp-3dsmax menu removed (deferred)\"\n"
    py += "''')\n"
    py += "            except Exception:\n"
    py += "                pass\n"
    py += "        _clear_uninstall_markers()\n"
    py += "        print('Completed deferred dcc-mcp-3dsmax uninstall')\n"
    py += "else:\n"
    py += "    env_paths = _env_python_paths()\n"
    py += "    _prepend(env_paths)\n"
    py += "    install_payload, install_payload_id = _installed_root()\n"
    py += "    _cleanup_obsolete_payloads(install_payload)\n"
    py += "    pkg, pkg_id = _validated_pkg(install_payload, install_payload_id)\n"
    py += "    if str(pkg) not in sys.path:\n"
    py += "        if env_paths:\n"
    py += "            sys.path.append(str(pkg))\n"
    py += "        else:\n"
    py += "            sys.path.insert(0, str(pkg))\n"
    py += "    os.environ.setdefault('DCC_MCP_SERVER_ROOT', str(pkg))\n"
    py += "    from dcc_mcp_core import capture_bootstrap_errors\n"
    py += "    min_core_version = '0.20.22'\n"
    py += "    max_core_version = '1.0.0'\n"
    py += "    min_server_version = '0.20.22'\n"
    py += "    max_server_version = '1.0.0'\n"
    py += "    def _release_version(value):\n"
    py += "        if not isinstance(value, str) or re.fullmatch('[0-9]+(?:[.][0-9]+)*', value) is None:\n"
    py += "            raise RuntimeError('invalid DCC MCP runtime version')\n"
    py += "        return tuple(int(part) for part in value.split('.'))\n"
    py += "    def _distribution_version(distribution):\n"
    py += "        expected = re.sub('[-_.]+', '-', distribution).lower()\n"
    py += "        matches = []\n"
    py += "        for metadata_path in sorted(pkg.glob('*.dist-info/METADATA')):\n"
    py += "            metadata = Parser().parsestr(metadata_path.read_text(encoding='utf-8'))\n"
    py += "            names = metadata.get_all('Name', [])\n"
    py += "            matching_names = [name for name in names if re.sub('[-_.]+', '-', name).lower() == expected]\n"
    py += "            if not matching_names:\n"
    py += "                continue\n"
    py += "            versions = metadata.get_all('Version', [])\n"
    py += "            if len(names) != 1 or len(matching_names) != 1 or len(versions) != 1:\n"
    py += "                raise RuntimeError('ambiguous ' + distribution + ' metadata')\n"
    py += "            matches.append(versions[0])\n"
    py += "        if len(matches) != 1:\n"
    py += "            raise RuntimeError('ambiguous ' + distribution + ' metadata')\n"
    py += "        return matches[0]\n"
    py += "    def _require_runtime_versions():\n"
    py += "        core = _release_version(_distribution_version('dcc-mcp-core'))\n"
    py += "        server = _release_version(_distribution_version('dcc-mcp-server'))\n"
    py += "        if not (_release_version(min_core_version) <= core < _release_version(max_core_version)):\n"
    py += "            raise RuntimeError('unsupported dcc-mcp-core version')\n"
    py += "        if not (_release_version(min_server_version) <= server < _release_version(max_server_version)):\n"
    py += "            raise RuntimeError('unsupported dcc-mcp-server version')\n"
    py += "    with capture_bootstrap_errors('3dsmax', adapter_version=None, min_core_version='0.20.22', phase='mzp_startup', log_dir=str(root / 'bootstrap-errors')):\n"
    py += "        _require_runtime_versions()\n"
    py += "        _controlled(pkg, install_payload, 'runtime package', pkg_id)\n"
    py += "        dcc_mcp_3dsmax = _import_bound(pkg, pkg_id, install_payload)\n"
    py += "        dcc_mcp_3dsmax.install_menu()\n"
    py += "        dcc_mcp_3dsmax.install_shutdown_callback()\n"
    py += "        dcc_mcp_3dsmax.main()\n"
    py += "        print('dcc-mcp-3dsmax runtime ready:', pkg)\n"
    python.Execute py
)

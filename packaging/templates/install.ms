-- dcc-mcp-3dsmax {{VERSION}} drag-and-drop installer.
(
    fn _dccMcpNormalizePath value =
    (
        substituteString value "\\" "/"
    )

    local sourceRoot = _dccMcpNormalizePath (getFilenamePath (getSourceFileName()))
    local userScripts = _dccMcpNormalizePath (getDir #userScripts)
    local userStartupScripts = _dccMcpNormalizePath (getDir #userStartupScripts)
    fn _dccMcpInstall =
    (
        local py = ""
        py += "from pathlib import Path\n"
        py += "from email.parser import Parser\n"
        py += "import os, re, shutil, sys, time, uuid\n"
        py += "source = Path(r'''" + sourceRoot + "''')\n"
        py += "install_dir = Path(r'''" + userScripts + "''') / 'dcc_mcp_3dsmax'\n"
        py += "versions_dir = install_dir / 'versions'\n"
        py += "current_file = install_dir / 'current.txt'\n"
        py += "uninstall_marker = Path(r'''" + userScripts + "''') / 'dcc_mcp_3dsmax_uninstall_pending'\n"
        py += "legacy_uninstall_marker = install_dir / 'dcc_mcp_3dsmax_uninstall_pending'\n"
        py += "uninstall_markers = [uninstall_marker, legacy_uninstall_marker]\n"
        py += "startup_dir = Path(r'''" + userStartupScripts + "''')\n"
        py += "startup_script = startup_dir / 'dcc_mcp_3dsmax_startup.ms'\n"
        py += "version_name = '{{VERSION}}'\n"
        py += "_SAFE_NAME = re.compile(r'[A-Za-z0-9][A-Za-z0-9._-]{0,127}\\Z')\n"
        py += "_RESERVED_NAMES = {'CON', 'PRN', 'AUX', 'NUL'} | {'COM' + str(i) for i in range(1, 10)} | {'LPT' + str(i) for i in range(1, 10)}\n"
        py += "_REPARSE_POINT = 0x400\n"
        py += "def _is_link_or_reparse(path):\n"
        py += "    try: info = os.lstat(str(path))\n"
        py += "    except OSError: return False\n"
        py += "    return path.is_symlink() or bool(getattr(info, 'st_file_attributes', 0) & _REPARSE_POINT)\n"
        py += "def _identity(path):\n"
        py += "    info = os.lstat(str(path))\n"
        py += "    return (getattr(info, 'st_dev', 0), getattr(info, 'st_ino', 0), getattr(info, 'st_mode', 0), getattr(info, 'st_file_attributes', 0))\n"
        py += "def _controlled(path, parent, label, identity=None, allow_missing=False):\n"
        py += "    parent_resolved = Path(os.path.realpath(str(parent)))\n"
        py += "    if _is_link_or_reparse(parent): raise RuntimeError('refusing linked/reparse ' + label + ' root')\n"
        py += "    if not os.path.lexists(str(path)):\n"
        py += "        if allow_missing: return None\n"
        py += "        raise RuntimeError(label + ' is missing')\n"
        py += "    if _is_link_or_reparse(path): raise RuntimeError('refusing linked/reparse ' + label)\n"
        py += "    resolved = Path(os.path.realpath(str(path)))\n"
        py += "    if resolved != parent_resolved and parent_resolved not in resolved.parents: raise RuntimeError(label + ' escapes controlled root')\n"
        py += "    actual = _identity(path)\n"
        py += "    if label == 'current.txt' and (not os.path.isfile(str(path)) or getattr(os.lstat(str(path)), 'st_nlink', 1) != 1): raise RuntimeError('current.txt must be an independent regular file')\n"
        py += "    if identity is not None and actual != identity: raise RuntimeError(label + ' identity changed')\n"
        py += "    return actual\n"
        py += "def _pkg(root):\n"
        py += "    return root / ('python37' if sys.version_info < (3, 8) else 'python')\n"
        py += "def _import_bound(pkg, pkg_id):\n"
        py += "    with os.scandir(str(pkg)) as _pkg_handle:\n"
        py += "        _controlled(pkg, pkg.parent, 'runtime package', pkg_id)\n"
        py += "        module = __import__('dcc_mcp_3dsmax')\n"
        py += "        _controlled(pkg, pkg.parent, 'runtime package', pkg_id)\n"
        py += "        return module\n"
        py += "def _clear_path(path, allow_restart=False):\n"
        py += "    if not os.path.lexists(str(path)):\n"
        py += "        return {'success': True, 'status': 'skipped'}\n"
        py += "    boundary = install_dir.parent if path == install_dir else install_dir\n"
        py += "    before_parent = _controlled(path.parent, boundary, 'cleanup parent')\n"
        py += "    before = _controlled(path, path.parent, 'cleanup target')\n"
        py += "    if path.is_file():\n"
        py += "        _controlled(path, path.parent, 'cleanup target', before)\n"
        py += "        path.unlink()\n"
        py += "        _controlled(path.parent, boundary, 'cleanup parent', before_parent)\n"
        py += "        if os.path.lexists(str(path)): raise RuntimeError('cleanup target reappeared')\n"
        py += "        return {'success': True, 'status': 'removed'}\n"
        py += "    try:\n"
        py += "        from dcc_mcp_core.install_lifecycle import safe_remove_tree\n"
        py += "    except Exception:\n"
        py += "        _controlled(path, path.parent, 'cleanup target', before)\n"
        py += "        raise RuntimeError('runtime cleanup helper unavailable; refusing recursive delete')\n"
        py += "        _controlled(path.parent, boundary, 'cleanup parent', before_parent)\n"
        py += "        if os.path.lexists(str(path)): raise RuntimeError('cleanup target reappeared')\n"
        py += "        return {'success': True, 'status': 'removed'}\n"
        py += "    _controlled(path, path.parent, 'cleanup target', before)\n"
        py += "    result = safe_remove_tree(path)\n"
        py += "    if os.path.lexists(str(path)):\n"
        py += "        _controlled(path, path.parent, 'cleanup target', before)\n"
        py += "    _controlled(path.parent, boundary, 'cleanup parent', before_parent)\n"
        py += "    if not result.get('requires_restart') and os.path.lexists(str(path)): raise RuntimeError('cleanup target reappeared')\n"
        py += "    if result.get('requires_restart') and allow_restart:\n"
        py += "        return result\n"
        py += "    if not result.get('success'):\n"
        py += "        raise RuntimeError(result.get('message') or result.get('status') or 'remove failed')\n"
        py += "    return result\n"
        py += "def _version_key():\n"
        py += "    safe = ''.join(ch if ch.isalnum() or ch in '._-' else '_' for ch in version_name) or 'dev'\n"
        py += "    return safe + '_' + time.strftime('%Y%m%d%H%M%S') + '_' + uuid.uuid4().hex[:8]\n"
        py += "def _active_root():\n"
        py += "    _controlled(install_dir, install_dir.parent, 'install', allow_missing=True)\n"
        py += "    if os.path.lexists(str(versions_dir)): _controlled(versions_dir, install_dir, 'versions')\n"
        py += "    if os.path.lexists(str(current_file)):\n"
        py += "        current_id = _controlled(current_file, install_dir, 'current.txt')\n"
        py += "        current = current_file.read_text(encoding='utf-8').strip()\n"
        py += "        _controlled(current_file, install_dir, 'current.txt', current_id)\n"
        py += "        if (not _SAFE_NAME.fullmatch(current or '') or current.rstrip(' .') != current or current.split('.')[0].upper() in _RESERVED_NAMES): raise RuntimeError('invalid active version name')\n"
        py += "        candidate = versions_dir / current\n"
        py += "        if os.path.lexists(str(candidate)):\n"
        py += "            candidate_id = _controlled(candidate, versions_dir, 'active version')\n"
        py += "            _controlled(candidate, versions_dir, 'active version', candidate_id)\n"
        py += "            return candidate, candidate_id\n"
        py += "    return install_dir, None\n"
        py += "def _copy_payload(target):\n"
        py += "    _controlled(target.parent, install_dir, 'versions')\n"
        py += "    _controlled(target, target.parent, 'staging payload', allow_missing=True)\n"
        py += "    shutil.copytree(source / 'payload', target)\n"
        py += "def _copy_startup(root):\n"
        py += "    _controlled(root, versions_dir, 'active version')\n"
        py += "    _controlled(startup_dir, startup_dir.parent, 'startup directory', allow_missing=True)\n"
        py += "    startup_dir.mkdir(parents=True, exist_ok=True)\n"
        py += "    with os.scandir(str(startup_dir)) as _startup_handle:\n"
        py += "        startup_parent_id = _controlled(startup_dir, startup_dir.parent, 'startup directory')\n"
        py += "        startup_before = _controlled(startup_script, startup_dir, 'startup script', allow_missing=True)\n"
        py += "        startup_tmp = startup_dir / ('.dcc_mcp_3dsmax_startup.' + uuid.uuid4().hex + '.tmp')\n"
        py += "        try:\n"
        py += "            _controlled(startup_tmp, startup_dir, 'startup temporary', allow_missing=True)\n"
        py += "            with open(str(root / 'startup' / 'dcc_mcp_3dsmax_startup.ms'), 'rb') as startup_src, os.fdopen(os.open(str(startup_tmp), os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, 'O_BINARY', 0), 0o600), 'wb') as startup_dst:\n"
        py += "                shutil.copyfileobj(startup_src, startup_dst)\n"
        py += "            startup_tmp_id = _controlled(startup_tmp, startup_dir, 'startup temporary')\n"
        py += "            _controlled(startup_dir, startup_dir.parent, 'startup directory', startup_parent_id)\n"
        py += "            _controlled(startup_tmp, startup_dir, 'startup temporary', startup_tmp_id)\n"
        py += "            if startup_before is not None: _controlled(startup_script, startup_dir, 'startup script', startup_before)\n"
        py += "            elif os.path.lexists(str(startup_script)): raise RuntimeError('startup script owner changed')\n"
        py += "            os.replace(str(startup_tmp), str(startup_script))\n"
        py += "            _controlled(startup_script, startup_dir, 'startup script')\n"
        py += "        except Exception:\n"
        py += "            if os.path.lexists(str(startup_tmp)):\n"
        py += "                _controlled(startup_tmp, startup_dir, 'startup temporary', startup_tmp_id if 'startup_tmp_id' in locals() else None)\n"
        py += "                startup_tmp.unlink()\n"
        py += "            raise\n"
        py += "def _stop_existing(action):\n"
        py += "    current_root, current_root_id = _active_root()\n"
        py += "    if not os.path.lexists(str(current_root)):\n"
        py += "        return\n"
        py += "    _controlled(current_root, versions_dir, 'active version', current_root_id) if current_root != install_dir else _controlled(current_root, install_dir.parent, 'install')\n"
        py += "    pkg = _pkg(current_root)\n"
        py += "    pkg_id = _controlled(pkg, current_root, 'runtime package')\n"
        py += "    _controlled(pkg, current_root, 'runtime package', pkg_id)\n"
        py += "    if pkg.exists() and str(pkg) not in sys.path:\n"
        py += "        _controlled(pkg, current_root, 'runtime package', pkg_id)\n"
        py += "        sys.path.insert(0, str(pkg))\n"
        py += "    try:\n"
        py += "        _controlled(pkg, current_root, 'runtime package', pkg_id)\n"
        py += "        dcc_mcp_3dsmax = _import_bound(pkg, pkg_id)\n"
        py += "    except ModuleNotFoundError:\n"
        py += "        return\n"
        py += "    try:\n"
        py += "        dcc_mcp_3dsmax.stop_sidecar_bridge()\n"
        py += "    except Exception as exc:\n"
        py += "        raise RuntimeError('Failed to stop dcc-mcp-3dsmax sidecar before ' + action + ': %s' % exc) from exc\n"
        py += "def _clear_uninstall_markers():\n"
        py += "    for marker in uninstall_markers:\n"
        py += "        try:\n"
        py += "            if os.path.lexists(str(marker)):\n"
        py += "                marker_id = _controlled(marker, marker.parent, 'uninstall marker')\n"
        py += "                _controlled(marker, marker.parent, 'uninstall marker', marker_id)\n"
        py += "                marker.unlink()\n"
        py += "                if os.path.lexists(str(marker)): raise RuntimeError('uninstall marker reappeared')\n"
        py += "        except OSError:\n"
        py += "            pass\n"
        py += "def _clear_adapter_modules():\n"
        py += "    for name in list(sys.modules):\n"
        py += "        if name == 'dcc_mcp_3dsmax' or name.startswith('dcc_mcp_3dsmax.'):\n"
        py += "            sys.modules.pop(name, None)\n"
        py += "def _cleanup_obsolete_payloads(active_key):\n"
        py += "    if (not _SAFE_NAME.fullmatch(active_key or '') or active_key.rstrip(' .') != active_key or active_key.split('.')[0].upper() in _RESERVED_NAMES): raise RuntimeError('invalid active version name')\n"
        py += "    active_root = versions_dir / active_key\n"
        py += "    _controlled(versions_dir, install_dir, 'versions')\n"
        py += "    _controlled(active_root, versions_dir, 'active version')\n"
        py += "    pkg = _pkg(active_root)\n"
        py += "    pkg_id = _controlled(pkg, active_root, 'runtime package')\n"
        py += "    _controlled(pkg, active_root, 'runtime package', pkg_id)\n"
        py += "    if pkg.exists() and str(pkg) not in sys.path:\n"
        py += "        sys.path.insert(0, str(pkg))\n"
        py += "    obsolete = []\n"
        py += "    if os.path.lexists(str(versions_dir)):\n"
        py += "        obsolete.extend(path for path in versions_dir.iterdir() if path.name != active_key and not path.name.endswith('.installing'))\n"
        py += "    if os.path.lexists(str(install_dir)):\n"
        py += "        for path in install_dir.iterdir():\n"
        py += "            if path.name in ('versions', 'current.txt'):\n"
        py += "                continue\n"
        py += "            if path in uninstall_markers:\n"
        py += "                continue\n"
        py += "            obsolete.append(path)\n"
        py += "    for path in obsolete:\n"
        py += "        try:\n"
        py += "            result = _clear_path(path, allow_restart=True)\n"
        py += "            if result.get('requires_restart'):\n"
        py += "                print('Old dcc-mcp-3dsmax payload cleanup requires restart:', path, result.get('message'))\n"
        py += "        except Exception as exc:\n"
        py += "            print('Failed to cleanup old dcc-mcp-3dsmax payload:', path, exc)\n"
        py += "def _activate_runtime(root):\n"
        py += "    _controlled(root, versions_dir, 'active version')\n"
        py += "    _clear_adapter_modules()\n"
        py += "    pkg = _pkg(root)\n"
        py += "    pkg_id = _controlled(pkg, root, 'runtime package')\n"
        py += "    _controlled(pkg, root, 'runtime package', pkg_id)\n"
        py += "    if str(pkg) not in sys.path:\n"
        py += "        sys.path.insert(0, str(pkg))\n"
        py += "    os.environ.setdefault('DCC_MCP_SERVER_ROOT', str(pkg))\n"
        py += "    from dcc_mcp_core import capture_bootstrap_errors\n"
        py += "    min_core_version = '0.20.22'\n"
        py += "    max_core_version = '1.0.0'\n"
        py += "    min_server_version = '0.20.22'\n"
        py += "    max_server_version = '1.0.0'\n"
        py += "    def _release_version(value):\n"
        py += "        if not isinstance(value, str) or re.fullmatch('[0-9]+(?:[.][0-9]+)*', value) is None:\n"
        py += "            raise RuntimeError('invalid DCC MCP runtime version')\n"
        py += "        return tuple(int(part) for part in value.split('.'))\n"
        py += "    def _distribution_version(distribution):\n"
        py += "        expected = re.sub('[-_.]+', '-', distribution).lower()\n"
        py += "        matches = []\n"
        py += "        for metadata_path in sorted(pkg.glob('*.dist-info/METADATA')):\n"
        py += "            metadata = Parser().parsestr(metadata_path.read_text(encoding='utf-8'))\n"
        py += "            names = metadata.get_all('Name', [])\n"
        py += "            matching_names = [name for name in names if re.sub('[-_.]+', '-', name).lower() == expected]\n"
        py += "            if not matching_names:\n"
        py += "                continue\n"
        py += "            versions = metadata.get_all('Version', [])\n"
        py += "            if len(names) != 1 or len(matching_names) != 1 or len(versions) != 1:\n"
        py += "                raise RuntimeError('ambiguous ' + distribution + ' metadata')\n"
        py += "            matches.append(versions[0])\n"
        py += "        if len(matches) != 1:\n"
        py += "            raise RuntimeError('ambiguous ' + distribution + ' metadata')\n"
        py += "        return matches[0]\n"
        py += "    def _require_runtime_versions():\n"
        py += "        core = _release_version(_distribution_version('dcc-mcp-core'))\n"
        py += "        server = _release_version(_distribution_version('dcc-mcp-server'))\n"
        py += "        if not (_release_version(min_core_version) <= core < _release_version(max_core_version)):\n"
        py += "            raise RuntimeError('unsupported dcc-mcp-core version')\n"
        py += "        if not (_release_version(min_server_version) <= server < _release_version(max_server_version)):\n"
        py += "            raise RuntimeError('unsupported dcc-mcp-server version')\n"
        py += "    with capture_bootstrap_errors('3dsmax', adapter_version='{{VERSION}}', min_core_version='0.20.22', phase='mzp_install', log_dir=str(install_dir / 'bootstrap-errors')):\n"
        py += "        _require_runtime_versions()\n"
        py += "        _controlled(pkg, root, 'runtime package', pkg_id)\n"
        py += "        dcc_mcp_3dsmax = _import_bound(pkg, pkg_id)\n"
        py += "        dcc_mcp_3dsmax.remove_menu()\n"
        py += "        dcc_mcp_3dsmax.install_menu()\n"
        py += "        dcc_mcp_3dsmax.install_shutdown_callback()\n"
        py += "        dcc_mcp_3dsmax.main()\n"
        py += "_stop_existing('install')\n"
        py += "_clear_adapter_modules()\n"
        py += "_controlled(install_dir, install_dir.parent, 'install', allow_missing=True)\n"
        py += "install_dir.mkdir(parents=True, exist_ok=True)\n"
        py += "_controlled(install_dir, install_dir.parent, 'install')\n"
        py += "_controlled(versions_dir, install_dir, 'versions', allow_missing=True)\n"
        py += "versions_dir.mkdir(parents=True, exist_ok=True)\n"
        py += "_controlled(versions_dir, install_dir, 'versions')\n"
        py += "_clear_uninstall_markers()\n"
        py += "key = _version_key()\n"
        py += "version_dir = versions_dir / key\n"
        py += "staging_dir = versions_dir / (key + '.installing')\n"
        py += "_clear_path(staging_dir)\n"
        py += "_copy_payload(staging_dir)\n"
        py += "_controlled(staging_dir, versions_dir, 'staging payload')\n"
        py += "staging_dir.rename(version_dir)\n"
        py += "_controlled(version_dir, versions_dir, 'active version')\n"
        py += "with os.scandir(str(install_dir)) as _install_handle:\n"
        py += "    install_before = _controlled(install_dir, install_dir.parent, 'install')\n"
        py += "    current_before = _controlled(current_file, install_dir, 'current.txt', allow_missing=True)\n"
        py += "    current_tmp = install_dir / ('.current.txt.' + uuid.uuid4().hex + '.tmp')\n"
        py += "    _controlled(current_tmp, install_dir, 'current.txt temporary', allow_missing=True)\n"
        py += "    with os.fdopen(os.open(str(current_tmp), os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, 'O_BINARY', 0), 0o600), 'w', encoding='utf-8', newline='') as current_stream:\n"
        py += "        current_stream.write(key + '\\n')\n"
        py += "    _controlled(current_tmp, install_dir, 'current.txt temporary')\n"
        py += "    if current_before is None:\n"
        py += "        if os.path.lexists(str(current_file)): raise RuntimeError('current.txt owner changed')\n"
        py += "    else:\n"
        py += "        _controlled(install_dir, install_dir.parent, 'install', install_before)\n"
        py += "        _controlled(current_file, install_dir, 'current.txt', current_before)\n"
        py += "    _controlled(install_dir, install_dir.parent, 'install', install_before)\n"
        py += "    if current_before is None and os.path.lexists(str(current_file)): raise RuntimeError('current.txt owner changed')\n"
        py += "    os.replace(str(current_tmp), str(current_file))\n"
        py += "    _controlled(install_dir, install_dir.parent, 'install', install_before)\n"
        py += "    _controlled(current_file, install_dir, 'current.txt')\n"
        py += "_copy_startup(version_dir)\n"
        py += "_cleanup_obsolete_payloads(key)\n"
        py += "_activate_runtime(version_dir)\n"
        py += "print('Installed dcc-mcp-3dsmax', version_name, 'to', version_dir)\n"
        try
        (
            python.Execute py
            messageBox "dcc-mcp-3dsmax installed and runtime startup requested." title:"dcc-mcp-3dsmax"
        )
        catch
        (
            messageBox ("dcc-mcp-3dsmax install failed:\n" + getCurrentException()) title:"dcc-mcp-3dsmax"
        )
    )

    fn _dccMcpUninstall =
    (
        local py = ""
        py += "from pathlib import Path\n"
        py += "import os, re, shutil, sys\n"
        py += "source = Path(r'''" + sourceRoot + "''')\n"
        py += "install_dir = Path(r'''" + userScripts + "''') / 'dcc_mcp_3dsmax'\n"
        py += "versions_dir = install_dir / 'versions'\n"
        py += "current_file = install_dir / 'current.txt'\n"
        py += "uninstall_marker = Path(r'''" + userScripts + "''') / 'dcc_mcp_3dsmax_uninstall_pending'\n"
        py += "legacy_uninstall_marker = install_dir / 'dcc_mcp_3dsmax_uninstall_pending'\n"
        py += "uninstall_markers = [uninstall_marker, legacy_uninstall_marker]\n"
        py += "startup_dir = Path(r'''" + userStartupScripts + "''')\n"
        py += "startup_script = Path(r'''" + userStartupScripts + "''') / 'dcc_mcp_3dsmax_startup.ms'\n"
        py += "_SAFE_NAME = re.compile(r'[A-Za-z0-9][A-Za-z0-9._-]{0,127}\\Z')\n"
        py += "_REPARSE_POINT = 0x400\n"
        py += "def _is_link_or_reparse(path):\n"
        py += "    try: info = os.lstat(str(path))\n"
        py += "    except OSError: return False\n"
        py += "    return path.is_symlink() or bool(getattr(info, 'st_file_attributes', 0) & _REPARSE_POINT)\n"
        py += "def _identity(path):\n"
        py += "    info = os.lstat(str(path))\n"
        py += "    return (getattr(info, 'st_dev', 0), getattr(info, 'st_ino', 0), getattr(info, 'st_mode', 0), getattr(info, 'st_file_attributes', 0))\n"
        py += "def _controlled(path, parent, label, identity=None, allow_missing=False):\n"
        py += "    parent_resolved = Path(os.path.realpath(str(parent)))\n"
        py += "    if _is_link_or_reparse(parent): raise RuntimeError('refusing linked/reparse ' + label + ' root')\n"
        py += "    if not os.path.lexists(str(path)):\n"
        py += "        if allow_missing: return None\n"
        py += "        raise RuntimeError(label + ' is missing')\n"
        py += "    if _is_link_or_reparse(path): raise RuntimeError('refusing linked/reparse ' + label)\n"
        py += "    resolved = Path(os.path.realpath(str(path)))\n"
        py += "    if resolved != parent_resolved and parent_resolved not in resolved.parents: raise RuntimeError(label + ' escapes controlled root')\n"
        py += "    actual = _identity(path)\n"
        py += "    if identity is not None and actual != identity: raise RuntimeError(label + ' identity changed')\n"
        py += "    return actual\n"
        py += "def _active_root():\n"
        py += "    _controlled(install_dir, install_dir.parent, 'install', allow_missing=True)\n"
        py += "    if os.path.lexists(str(versions_dir)): _controlled(versions_dir, install_dir, 'versions')\n"
        py += "    if os.path.lexists(str(current_file)):\n"
        py += "        current_id = _controlled(current_file, install_dir, 'current.txt')\n"
        py += "        current = current_file.read_text(encoding='utf-8').strip()\n"
        py += "        _controlled(current_file, install_dir, 'current.txt', current_id)\n"
        py += "        if not _SAFE_NAME.fullmatch(current or ''): raise RuntimeError('invalid active version name')\n"
        py += "        candidate = versions_dir / current\n"
        py += "        if os.path.lexists(str(candidate)):\n"
        py += "            candidate_id = _controlled(candidate, versions_dir, 'active version')\n"
        py += "            _controlled(candidate, versions_dir, 'active version', candidate_id)\n"
        py += "            return candidate, candidate_id\n"
        py += "    return install_dir, None\n"
        py += "def _validated_pkg(base, base_id=None):\n"
        py += "    if base == install_dir: _controlled(base, install_dir.parent, 'install')\n"
        py += "    else: _controlled(base, versions_dir, 'active version', base_id)\n"
        py += "    pkg = base / ('python37' if sys.version_info < (3, 8) else 'python')\n"
        py += "    pkg_id = _controlled(pkg, base, 'runtime package')\n"
        py += "    _controlled(pkg, base, 'runtime package', pkg_id)\n"
        py += "    return pkg, pkg_id\n"
        py += "active_root, active_root_id = _active_root()\n"
        py += "pkg, pkg_id = _validated_pkg(active_root, active_root_id)\n"
        py += "if str(pkg) not in sys.path:\n"
        py += "    sys.path.insert(0, str(pkg))\n"
        py += "try:\n"
        py += "    _controlled(pkg, active_root, 'runtime package', pkg_id)\n"
        py += "    import dcc_mcp_3dsmax\n"
        py += "    dcc_mcp_3dsmax.stop_sidecar_bridge()\n"
        py += "    dcc_mcp_3dsmax.remove_menu()\n"
        py += "except ModuleNotFoundError:\n"
        py += "    pass\n"
        py += "except Exception as exc:\n"
        py += "    raise RuntimeError('Failed to stop dcc-mcp-3dsmax sidecar before uninstall: {}'.format(exc)) from exc\n"
        py += "def _clear_adapter_modules():\n"
        py += "    for name in list(sys.modules):\n"
        py += "        if name == 'dcc_mcp_3dsmax' or name.startswith('dcc_mcp_3dsmax.'):\n"
        py += "            sys.modules.pop(name, None)\n"
        py += "def _clear_uninstall_markers():\n"
        py += "    for marker in uninstall_markers:\n"
        py += "        try:\n"
        py += "            if os.path.lexists(str(marker)):\n"
        py += "                marker_id = _controlled(marker, marker.parent, 'uninstall marker')\n"
        py += "                _controlled(marker, marker.parent, 'uninstall marker', marker_id)\n"
        py += "                marker.unlink()\n"
        py += "                if os.path.lexists(str(marker)): raise RuntimeError('uninstall marker reappeared')\n"
        py += "        except OSError:\n"
        py += "            pass\n"
        py += "def _clear_path(path):\n"
        py += "    if os.path.lexists(str(path)):\n"
        py += "        boundary = install_dir.parent if path == install_dir else install_dir\n"
        py += "        before_parent = _controlled(path.parent, boundary, 'cleanup parent')\n"
        py += "        before = _controlled(path, path.parent, 'cleanup target')\n"
        py += "        if path.is_file():\n"
        py += "            _controlled(path, path.parent, 'cleanup target', before)\n"
        py += "            path.unlink()\n"
        py += "            _controlled(path.parent, boundary, 'cleanup parent', before_parent)\n"
        py += "            if os.path.lexists(str(path)): raise RuntimeError('cleanup target reappeared')\n"
        py += "            return {'success': True, 'status': 'removed'}\n"
        py += "        try:\n"
        py += "            from dcc_mcp_core.install_lifecycle import safe_remove_tree\n"
        py += "        except Exception:\n"
        py += "            _controlled(path, path.parent, 'cleanup target', before)\n"
        py += "            raise RuntimeError('runtime cleanup helper unavailable; refusing recursive delete')\n"
        py += "            _controlled(path.parent, boundary, 'cleanup parent', before_parent)\n"
        py += "            if os.path.lexists(str(path)): raise RuntimeError('cleanup target reappeared')\n"
        py += "            return {'success': True, 'status': 'removed'}\n"
        py += "        _controlled(path, path.parent, 'cleanup target', before)\n"
        py += "        result = safe_remove_tree(path)\n"
        py += "        if os.path.lexists(str(path)):\n"
        py += "            _controlled(path, path.parent, 'cleanup target', before)\n"
        py += "        _controlled(path.parent, boundary, 'cleanup parent', before_parent)\n"
        py += "        if not result.get('requires_restart') and os.path.lexists(str(path)): raise RuntimeError('cleanup target reappeared')\n"
        py += "        if result.get('requires_restart'):\n"
        py += "            raise PermissionError(result.get('message') or result.get('recommended_next_action'))\n"
        py += "        if not result.get('success'):\n"
        py += "            raise RuntimeError(result.get('message') or result.get('status') or 'remove failed')\n"
        py += "        return result\n"
        py += "    return {'success': True, 'status': 'skipped'}\n"
        py += "try:\n"
        py += "    _clear_adapter_modules()\n"
        py += "    _clear_path(install_dir)\n"
        py += "    if os.path.lexists(str(startup_script)):\n"
        py += "        startup_id = _controlled(startup_script, startup_dir, 'startup script')\n"
        py += "        _controlled(startup_script, startup_dir, 'startup script', startup_id)\n"
        py += "        startup_script.unlink()\n"
        py += "        if os.path.lexists(str(startup_script)): raise RuntimeError('startup script reappeared')\n"
        py += "    _clear_uninstall_markers()\n"
        py += "    print('Uninstalled dcc-mcp-3dsmax from', install_dir)\n"
        py += "except PermissionError as exc:\n"
        py += "    uninstall_marker.parent.mkdir(parents=True, exist_ok=True)\n"
        py += "    startup_dir.mkdir(parents=True, exist_ok=True)\n"
        py += "    startup_parent_id = _controlled(startup_dir, startup_dir.parent, 'startup directory')\n"
        py += "    uninstall_marker.write_text('pending\\n', encoding='utf-8')\n"
        py += "    startup_before = _controlled(startup_script, startup_dir, 'startup script', allow_missing=True)\n"
        py += "    startup_tmp = startup_dir / ('.dcc_mcp_3dsmax_startup.' + __import__('uuid').uuid4().hex + '.tmp')\n"
        py += "    with open(str(source / 'payload' / 'startup' / 'dcc_mcp_3dsmax_startup.ms'), 'rb') as startup_src, os.fdopen(os.open(str(startup_tmp), os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, 'O_BINARY', 0), 0o600), 'wb') as startup_dst:\n"
        py += "        shutil.copyfileobj(startup_src, startup_dst)\n"
        py += "    startup_tmp_id = _controlled(startup_tmp, startup_dir, 'startup temporary')\n"
        py += "    _controlled(startup_dir, startup_dir.parent, 'startup directory', startup_parent_id)\n"
        py += "    _controlled(startup_tmp, startup_dir, 'startup temporary', startup_tmp_id)\n"
        py += "    if startup_before is not None: _controlled(startup_script, startup_dir, 'startup script', startup_before)\n"
        py += "    elif os.path.lexists(str(startup_script)): raise RuntimeError('startup script owner changed')\n"
        py += "    os.replace(str(startup_tmp), str(startup_script))\n"
        py += "    _controlled(startup_script, startup_dir, 'startup script')\n"
        py += "    print('dcc-mcp-3dsmax uninstall requires a 3ds Max restart; staged cleanup for', install_dir, 'because:', exc)\n"
        try
        (
            python.Execute py
            messageBox "dcc-mcp-3dsmax uninstall requested. Restart 3ds Max to finish if files were in use." title:"dcc-mcp-3dsmax"
        )
        catch
        (
            messageBox ("dcc-mcp-3dsmax uninstall failed:\n" + getCurrentException()) title:"dcc-mcp-3dsmax"
        )
    )

    rollout dccMcpInstaller "dcc-mcp-3dsmax" width:280 height:110
    (
        label infoLbl "Choose an action for dcc-mcp-3dsmax:" pos:[20,16]
        button installBtn "Install" width:110 height:28 pos:[20,50]
        button uninstallBtn "Uninstall" width:110 height:28 pos:[145,50]

        on installBtn pressed do
        (
            destroyDialog dccMcpInstaller
            _dccMcpInstall()
        )

        on uninstallBtn pressed do
        (
            destroyDialog dccMcpInstaller
            _dccMcpUninstall()
        )
    )

    createDialog dccMcpInstaller style:#(#style_titlebar, #style_border, #style_sysmenu)
)
